<!DOCTYPE html>
<html>
<head>
    <title>Resume Screening System</title>

    <style>
        body {
            font-family: Arial;
            background: #f2f2f2;
            text-align: center;
        }

        .container {
            width: 500px;
            margin: 50px auto;
            background: white;
            padding: 30px;
            border-radius: 10px;
        }

        input, textarea {
            width: 90%;
            padding: 12px;
            margin: 10px;
        }

        button {
            padding: 12px 25px;
            cursor: pointer;
        }

        #result {
            margin-top: 20px;
            font-weight: bold;
        }
    </style>
</head>

<body>

<div class="container">

    <h1>📄 Resume Screening System</h1>

    <input type="text" id="name"
           placeholder="Candidate Name">

    <textarea id="skills"
              placeholder="Enter candidate skills"></textarea>

    <input type="text" id="required"
           placeholder="Required skills">

    <button onclick="screenResume()">
        Screen Resume
    </button>

    <p id="result"></p>

</div>

<script>

function screenResume() {

    let name = document.getElementById("name").value;

    let skills =
        document.getElementById("skills").value.toLowerCase();

    let required =
        document.getElementById("required").value.toLowerCase();

    let requiredSkills = required.split(",");

    let matched = [];

    for (let skill of requiredSkills) {

        skill = skill.trim();

        if (skills.includes(skill)) {
            matched.push(skill);
        }
    }

    let result = document.getElementById("result");

    if (matched.length > 0) {

        result.innerHTML =
            name + " matches " +
            matched.length +
            " required skill(s): " +
            matched.join(", ");

    } else {

        result.innerHTML =
            "No matching skills found.";
    }
}

</script>

</body>
</html>
